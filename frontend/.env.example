# ============================================================
# Sky Tex — Environment Variables
# Copy to .env and fill in real values. NEVER commit .env!
# ============================================================

# ---- Database (Neon PostgreSQL) ----
# Get this from Neon dashboard → Connection Details → Connection String
DATABASE_URL=postgresql://user:pass@ep-xxxx.us-east-2.aws.neon.tech/skytex?sslmode=require

# ---- Frontend URL (for CORS) ----
# Set to your Vercel deployment URL
FRONTEND_URL=https://skytex.vercel.app

# ---- JWT Secret Key ----
# Generate a strong random key: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Render auto-generates this via render.yaml
SECRET_KEY=your-secret-key-change-in-production

# ---- Environment ----
# Set to "production" on Render to disable /docs endpoint
ENVIRONMENT=development

# ---- Admin Credentials (for seed.py only) ----
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# ---- Upload Directory (optional) ----
# Defaults to /app/uploads in Docker/Render
# UPLOAD_DIR=/app/uploads
